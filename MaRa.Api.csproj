<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MaRa.Api</RootNamespace>
    <AssemblyName>MaRa.Api</AssemblyName>
    <UserSecretsId>mara-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de données -->
    <PackageReference Include="Microsoft.EntityFrameworkCore"               Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"        Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"       Version="8.0.8" />

    <!-- Identité et authentification -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"     Version="8.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"                   Version="7.6.3" />

    <!-- Journalisation structurée -->
    <PackageReference Include="Serilog.AspNetCore"                          Version="8.0.2" />
    <PackageReference Include="Serilog.Enrichers.Environment"               Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL.Alternative"        Version="4.0.1" />

    <!-- Documentation API -->
    <PackageReference Include="Swashbuckle.AspNetCore"                      Version="6.7.3" />
  </ItemGroup>

</Project>
